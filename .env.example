# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real secrets.

# Leave unset in development; Django falls back to a throwaway key.
# SECRET_KEY=
# DEBUG=True
# ALLOWED_HOSTS=127.0.0.1,localhost

# KHQR — the same static QR is shown for every order, so transfers are
# verified by hand from the seller dashboard.
# KHQR_IMAGE is a path inside `static/`. KHQR_PAY_LINK is the bank's
# "scan to pay" link, opened by the button on mobile (leave blank to hide it).
KHQR_MERCHANT_NAME=YOUR NAME
KHQR_BANK_NAME=ACLEDA Bank
KHQR_IMAGE=assets/imgs/khqr/khqr-acleda.png
KHQR_PAY_LINK=
